FROM centos:7

RUN rm -f /etc/yum.repos.d/CentOS-*.repo && \
    cat > /etc/yum.repos.d/cooluc.repo <<'REPO'
[base]
name=CentOS-7 - Base
mirrorlist=http://mirrorlist.cooluc.com/?release=7&arch=$basearch&repo=os
gpgcheck=0
enabled=1

[updates]
name=CentOS-7 - Updates
mirrorlist=http://mirrorlist.cooluc.com/?release=7&arch=$basearch&repo=updates
gpgcheck=0
enabled=1

[extras]
name=CentOS-7 - Extras
mirrorlist=http://mirrorlist.cooluc.com/?release=7&arch=$basearch&repo=extras
gpgcheck=0
enabled=1

[devtoolset-12]
name=devtoolset-12
baseurl=https://download.copr.fedorainfracloud.org/results/mlampe/devtoolset-12/epel-7-$basearch/
type=rpm-md
skip_if_unavailable=True
gpgcheck=0
repo_gpgcheck=0
enabled=1
REPO

RUN yum -y install yum-utils rpm-build createrepo rpmdevtools rpm-sign gnupg2 \
      make wget curl tar xz bzip2 gzip zip unzip cpio which patch diffutils \
      findutils file sed gawk grep glibc-devel glibc-static bison flex m4 \
      gettext texinfo autoconf automake libtool pkgconfig python3 python2 \
      perl perl-devel perl-generators scl-utils scl-utils-build sudo \
      jansson-devel zlib-devel sharutils bc dejagnu libstdc++-static \
      elfutils-debuginfod-client-devel ncurses-devel readline-devel expat-devel \
      libstdc++-devel gmp-devel mpfr-devel libmpc-devel isl-devel xz-devel \
      guile-devel libtool-ltdl-devel && \
    yum -y install devtoolset-12-gcc devtoolset-12-gcc-c++ devtoolset-12-make \
      devtoolset-12-binutils devtoolset-12-runtime devtoolset-12-elfutils \
      devtoolset-12-gdb && \
    yum clean all && rm -rf /var/cache/yum

RUN cat > /root/.rpmmacros <<'MACRO'
%_topdir /build
%_sourcedir /build/SOURCES
%_specdir /build/SPECS
%_builddir /build/BUILD
%_buildrootdir /build/BUILDROOT
%_rpmdir /out/rpms
%_srcrpmdir /out/srpms
%dist .el7
%el7 1
%rhel 7
%devtoolset_14 1
%_scl_prefix /opt/rh
%_missing_doc_files_terminate_build 0
%_unpackaged_files_terminate_build 0
%__brp_mangle_shebangs %{nil}
%__brp_python_bytecompile %{nil}
%__brp_strip_static_archive %{nil}
%__brp_ldconfig %{nil}
%__brp_check_rpaths %{nil}
%__brp_strip_comment_note %{nil}
%__brp_strip %{nil}
%__jar_repack %{nil}
%set_build_flags %{expand:RPM_SOURCE_DIR="%{_sourcedir}" ; export RPM_SOURCE_DIR ; RPM_BUILD_DIR="%{_builddir}" ; export RPM_BUILD_DIR ; RPM_OPT_FLAGS="%{optflags}" ; export RPM_OPT_FLAGS ; RPM_LD_FLAGS="%{?__global_ldflags}" ; export RPM_LD_FLAGS ; RPM_ARCH="%{_target_cpu}" ; export RPM_ARCH ; RPM_OS="linux" ; export RPM_OS ; RPM_DOC_DIR="%{_docdir}" ; export RPM_DOC_DIR ;}
MACRO

WORKDIR /workspace
